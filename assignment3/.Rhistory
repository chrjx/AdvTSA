resid <- pred_df$observed - pred_df$predicted
rmse <- sqrt(mean(resid^2))
r2 <- 1 - sum(resid^2) / sum((pred_df$observed - mean(pred_df$observed))^2)
cat("\nRMSE:", round(rmse, 3), "| R²:", round(r2, 4), "\n\n")
# ---------------------------------------------------------------
# 2.3.4: Fit all events
# ---------------------------------------------------------------
cat("=== 2.3.4: Fitting All Events ===\n\n")
results <- data.frame()
all_preds <- list()
for (ev in events) {
cat("Event", ev, "...")
df <- subset(data, Event_ID == ev)
fit <- tryCatch({
fit_model(df)
}, error = function(e) {
cat(" Error in fitting:", e$message, "\n")
return(NULL)
})
if (!is.null(fit)) {
tryCatch({
sm <- summary(fit)
# Extract coefficients safely
coef_est <- sm$coefficients[, "Estimate"]
results <- rbind(results, data.frame(
event = ev,
logLik = sm$logLik,
AIC = -2 * sm$logLik + 2 * length(coef(fit)),
K1 = as.numeric(coef_est["K1"]),
K2 = as.numeric(coef_est["K2"]),
K3 = as.numeric(coef_est["K3"]),
A = as.numeric(coef_est["A"]),
Vmax = as.numeric(coef_est["Vmax"])
))
# Get predictions - try multiple approaches
pred_vals <- NULL
# Try 1: from states
if (!is.null(fit$states) && !is.null(fit$states$mean) &&
!is.null(fit$states$mean$prior) && !is.null(fit$states$mean$prior$x3)) {
pred_vals <- fit$states$mean$prior$x3
}
# Try 2: simulate manually if states not available
if (is.null(pred_vals) || length(pred_vals) == 0) {
pred_vals <- simulate_predictions(fit, df)
}
if (length(pred_vals) == nrow(df)) {
all_preds[[as.character(ev)]] <- data.frame(
event = ev,
time = df$t - min(df$t),
observed = df$Volume / 1000,
predicted = pred_vals,
rainfall = df$Rainfall
)
cat(" Done\n")
} else {
cat(" Length mismatch:", length(pred_vals), "vs", nrow(df), "\n")
}
}, error = function(e) {
cat(" Extraction error:", conditionMessage(e), "\n")
})
} else {
cat(" Conv issue (", conv_code, ")\n")
}
}
}
