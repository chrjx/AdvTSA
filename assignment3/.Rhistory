library(ctsmTMB)
library(dplyr)
library(lubridate)
library(ggplot2)
df_raw <- read.csv("ex3_largecase.csv")
colnames(df_raw)
S <- 1000
results_list <- list()
fits_list <- list()
for (evt_id in 1:6) {
cat(paste0("\n==================================\n"))
cat(paste0("Starting Estimation for Event: ", evt_id, "\n"))
data_evt <- df_raw %>%
filter(event == evt_id) %>%
mutate(
t = as.numeric(difftime(ymd_hms(timestamp), min(ymd_hms(timestamp)), units = "hours")),
y = volume / S,
p = pumpflow * 0.06,
r = rainfall
) %>%
select(t, y, p, r)
model <- ctsmTMB$new()
model$addSystem(
dx1 ~ A * r * dt - (1/K1) * x1 * dt + exp(log_sigma1) * dw1,
dx2 ~ (1/K1) * x1 * (1 / (1 + exp(-alpha * (x1 - beta)))) * dt - (1/K2) * x2 * dt + exp(log_sigma2) * dw2,
dx3 ~ (1/K2) * x2 * dt - p * dt + exp(log_sigma3) * dw3
)
model$addObs(y ~ x3)
model$setVariance(y ~ exp(log_sigma_y)^2)
model$addInput(r, p)
model$setParameter(
A           = c(init = 10,   lb = 0.1, ub = 100),
K1          = c(init = 2,    lb = 0.01, ub = 30),
K2          = c(init = 2,    lb = 0.01, ub = 30),
alpha       = c(init = 5,    lb = 0.1,  ub = 50),
beta        = c(init = 5,    lb = 0.1,  ub = 50),
# 噪声参数 (Log scale)
log_sigma1  = c(init = -1,   lb = -10,  ub = 3),
log_sigma2  = c(init = -1,   lb = -10,  ub = 3),
log_sigma3  = c(init = -3,   lb = -10,  ub = 1),
# 观测噪声下限设高一点，增加鲁棒性
log_sigma_y = c(init = -2,   lb = -3,   ub = 1)
)
model$setInitialState(list(c(0, 0, data_evt$y[1]), diag(0.1, 3)))
fit_result <- try(model$estimate(data_evt), silent = FALSE)
if (!inherits(fit_result, "try-error")) {
cat("--> Success!\n")
fits_list[[evt_id]] <- fit_result
est_pars <- coef(fit_result)
results_list[[evt_id]] <- c(event = evt_id, est_pars, AIC = AIC(fit_result))
} else {
cat("--> Failed to converge for Event", evt_id, "\n")
}
}
